{
  "name": "waymark",
  "description": "Record click-by-click walkthroughs of web apps and replay them on the live page.",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:test": "WAYMARK_TEST=1 wxt build --mode test",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "vitest run --project perf",
    "test:e2e": "pnpm build:test && playwright test",
    "check:manifest": "node scripts/check-manifest.mjs .output/chrome-mv3/manifest.json && node scripts/check-manifest.mjs .output-test/chrome-mv3-test/manifest.json && node scripts/check-no-cdn.mjs .output/chrome-mv3 && node scripts/check-no-cdn.mjs .output-test/chrome-mv3-test",
    "fixture": "node test/fixtures/server.mjs",
    "test:e2e:xvfb": "pnpm build:test && xvfb-run -a playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm build:test && pnpm check:manifest && pnpm test",
    "demo": "node demo/serve.mjs",
    "screens": "pnpm build:test && xvfb-run -a playwright test -c playwright.screens.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@huggingface/transformers": "3.8.1",
    "@preact/signals": "^2.11.4",
    "minisearch": "7.2.0",
    "preact": "^10.29.8",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
